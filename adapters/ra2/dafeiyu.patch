@@ -0,0 +1,24 @@
+import { expect, it } from 'vitest';
+import { scoutFrontiers, validateOilCapture } from '../../src/games/shared/scoutFrontiers';
+
+it('returns only valid shrouded terrain next to revealed samples, with bounded reads', () => {
+  let reads = 0;
+  const result = scoutFrontiers([{ x: 12, y: 12 }], ({ x, y }) => {
+    reads++;
+    if (x < 0 || y < 0 || x > 32 || y > 32) return 'invalid';
+    return x <= 12 ? 'revealed' : 'shrouded';
+  });
+  expect(result.frontiers.length).toBeGreaterThan(0);
+  expect(result.frontiers.every(c => c.x === 16 && c.y >= 0 && c.y <= 32)).toBe(true);
+  expect(reads).toBeLessThan(250);
+  expect(scoutFrontiers([{ x: 12, y: 12 }], () => 'shrouded').frontiers).toEqual([]);
+});
+
+it('requires an engineer and a neutral oil derrick for capture', () => {
+  const unit = { type: 'ENGINEER', kind: 'infantry' };
+  const oil = { type: 'CAOILD', kind: 'building', relation: 'neutral' };
+  expect(() => validateOilCapture(unit, oil)).not.toThrow();
+  expect(() => validateOilCapture({ ...unit, type: 'MTNK' }, oil)).toThrow();
+  expect(() => validateOilCapture(unit, { ...oil, relation: 'enemy' })).toThrow();
+  expect(() => validateOilCapture(unit, { ...oil, type: 'GACNST' })).toThrow();
+});
