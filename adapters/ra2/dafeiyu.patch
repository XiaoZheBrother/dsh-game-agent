+  const gain = { gain: { value: 0 }, connect: vi.fn() };
+  const context = {
+    state: 'running',
+    destination: {},
+    close: vi.fn(async () => {}),
+    createGain: () => gain,
+    createMediaStreamDestination: vi.fn(() => capture),
+  };
+  const sink = new WebAudioPcmSink({ contextFactory: () => context as unknown as AudioContext });
+  expect(sink.getCaptureStream()).toBe(stream);
+  expect(sink.getCaptureStream()).toBe(stream);
+  expect(context.createMediaStreamDestination).toHaveBeenCalledTimes(1);
+  expect(gain.connect).toHaveBeenCalledWith(context.destination);
+  expect(gain.connect).toHaveBeenCalledWith(capture);
+  expect(track.stop).not.toHaveBeenCalled();
+  await sink.destroy();
+  expect(track.stop).toHaveBeenCalledTimes(1);
+  expect(sink.getCaptureStream()).toBeNull();
+});
