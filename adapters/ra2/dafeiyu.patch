+++ b/src/games/shared/scoutFrontiers.ts
@@ -0,0 +1,35 @@
+type Cell = { x: number; y: number };
+
+/** Bounded local samples of native shroud, never hidden object positions or path guarantees. */
+export function scoutFrontiers(anchors: Cell[], state: (cell: Cell) => 'invalid' | 'revealed' | 'shrouded') {
+  const cache = new Map<string, ReturnType<typeof state>>();
+  const read = (cell: Cell) => {
+    const key = `${cell.x},${cell.y}`;
+    if (!cache.has(key)) cache.set(key, state(cell));
+    return cache.get(key)!;
+  };
+  const result = new Map<string, Cell>();
+  const regions = new Set<string>();
+  for (const anchor of anchors) {
+    const region = `${Math.floor(anchor.x / 12)},${Math.floor(anchor.y / 12)}`;
+    if (regions.has(region)) continue;
+    if (regions.size >= 8) break;
+    regions.add(region);
+    for (let dx = -24; dx <= 24; dx += 4) for (let dy = -24; dy <= 24; dy += 4) {
+      const cell = { x: anchor.x + dx, y: anchor.y + dy };
+      if (read(cell) !== 'revealed') continue;
+      for (const [x, y] of [[4, 0], [-4, 0], [0, 4], [0, -4]]) {
+        const next = { x: cell.x + x!, y: cell.y + y! };
+        if (read(next) === 'shrouded') result.set(`${next.x},${next.y}`, next);
+      }
+    }
+  }
+  return { source: 'native-local-shroud' as const, frontiers: [...result.values()].slice(0, 64) };
+}
+
+export function validateOilCapture(unit: { type: string; kind: string }, target: { type: string; kind: string; relation?: string }) {
+  if (unit.kind !== 'infantry' || !['ENGINEER', 'SENGINEER', 'YENGINEER'].includes(unit.type))
+    throw new Error('Capture requires an owned engineer');
+  if (target.kind !== 'building' || target.type !== 'CAOILD' || target.relation !== 'neutral')
+    throw new Error('Capture requires a visible neutral oil derrick');
+}
diff --git a/src/platform/browser/canvasBroadcast.ts b/src/platform/browser/canvasBroadcast.ts
new file mode 100644
index 0000000..adac4f1
--- /dev/null
+++ b/src/platform/browser/canvasBroadcast.ts
@@ -0,0 +1,183 @@
+/** Local canvas and session-audio broadcast. Never captures the desktop or microphone. */
+export function startCanvasBroadcast(
+  canvas: HTMLCanvasElement,
+  render: () => number | void,
+  endpoint: string,
+  presented: () => void = () => {},
+  audioSource: () => MediaStream | null = () => null,
+): () => void {
+  let dead = false;
+  let peer: RTCPeerConnection | null = null;
+  let stream: MediaStream | null = null;
+  let identity: string | null = null;
+  let audioIdentity: string | undefined;
+  let clock: Worker | null = null;
+  let meter: ReturnType<typeof setInterval> | null = null;
+  let timer: ReturnType<typeof setTimeout>;
+  const abort = new AbortController();
+  // Bound encoder work independently from the VM's display resolution.
+  const output = document.createElement('canvas');
+  const context = output.getContext('2d', { alpha: false });
+  if (!context) return () => {};
+  const reset = () => {
+    if (meter) clearInterval(meter);
+    meter = null;
+    clock?.terminate();
+    clock = null;
+    peer?.close();
+    peer = null;
+    stream?.getTracks().forEach((track) => track.stop());
+    stream = null;
+    identity = null;
+    audioIdentity = undefined;
+  };
+  async function poll() {
+    try {
+      const response = await fetch(endpoint, { signal: abort.signal });
+      if (!response.ok) throw new Error('Broadcast unavailable');
+      const { token, signal } = await response.json();
+      const sourceAudio = audioSource()?.getAudioTracks()[0];
+      if (peer && audioIdentity !== sourceAudio?.id) reset();
+      if (!signal) reset();
+      else if (signal.id !== identity) {
+        reset();
+        identity = signal.id;
+        const current = new RTCPeerConnection({ iceServers: [] });
+        peer = current;
+        await current.setRemoteDescription({ type: 'offer', sdp: signal.offer });
+        const scale = Math.min(1, 1280 / canvas.width, 960 / canvas.height);
+        output.width = Math.max(2, Math.floor((canvas.width * scale) / 2) * 2);
+        output.height = Math.max(2, Math.floor((canvas.height * scale) / 2) * 2);
+        stream = output.captureStream(0);
+        const track = stream.getVideoTracks()[0] as CanvasCaptureMediaStreamTrack;
+        track.contentHint = 'motion';
+        const sender = current.addTrack(track, stream);
+        if (sourceAudio) {
+          const audioTrack = sourceAudio.clone();
+          stream.addTrack(audioTrack);
+          current.addTrack(audioTrack, stream);
+          audioIdentity = sourceAudio.id;
+        }
+        await current.setLocalDescription(await current.createAnswer());
+        await new Promise<void>((resolve) => {
+          if (current.iceGatheringState === 'complete') return resolve();
+          const timeout = setTimeout(resolve, 2500);
+          current.addEventListener('icegatheringstatechange', () => {
+            if (current.iceGatheringState === 'complete') {
+              clearTimeout(timeout);
+              resolve();
+            }
+          });
+        });
+        if (dead || peer !== current) return;
+        const parameters = sender.getParameters();
+        if (parameters.encodings?.length) {
+          parameters.encodings[0]!.maxBitrate = 10_000_000;
+          parameters.encodings[0]!.maxFramerate = 60;
+          parameters.degradationPreference = 'maintain-framerate';
+          await sender.setParameters(parameters);
+        }
+        const result = await fetch(endpoint, {
+          method: 'POST',
+          signal: abort.signal,
+          headers: { 'Content-Type': 'application/json', 'X-Video-Token': token },
+          body: JSON.stringify({ kind: 'answer', id: identity, sdp: current.localDescription!.sdp }),
+        });
+        if (!result.ok) throw new Error('Broadcast answer rejected');
+        // A background tab's rAF is throttled. Render only the latest frame on the broadcast clock.
+        const url = URL.createObjectURL(
+          new Blob(
+            [
+              'let pending=false;onmessage=()=>pending=false;setInterval(()=>{if(!pending){pending=true;postMessage(0)}},1000/60)',
+            ],
+            { type: 'text/javascript' },
+          ),
+        );
+        clock = new Worker(url);
+        URL.revokeObjectURL(url);
+        let ticks = 0,
+          renderTime = 0,
+          previousFrames = 0,
+          previousEncode = 0,
+          previousTime = performance.now();
+        let measuring = false;
+        let uniqueFrames = 0,
+          lastVersion: number | void;
+        meter = setInterval(async () => {
+          if (measuring || dead || peer !== current) return;
+          measuring = true;
+          try {
+            const reports = await sender.getStats();
+            for (const report of reports.values()) {
+              if (report.type !== 'outbound-rtp' || report.kind !== 'video') continue;
+              const now = performance.now(),
+                frames = report.framesEncoded || 0,
+                encoded = report.totalEncodeTime || 0;
+              const values = {
+                fps: Math.max(0, ((frames - previousFrames) * 1000) / (now - previousTime)),
+                frames,
+                sourceFPS: (uniqueFrames * 1000) / (now - previousTime),
+                width: output.width,
+                height: output.height,
+                encodeMs: frames > previousFrames ? ((encoded - previousEncode) * 1000) / (frames - previousFrames) : 0,
+                renderMs: ticks ? renderTime / ticks : 0,
+                ticks,
+                timestamp: Date.now(),
+              };
+              uniqueFrames = 0;
+              previousFrames = frames;
+              previousEncode = encoded;
+              previousTime = now;
+              ticks = 0;
+              renderTime = 0;
+              await fetch(endpoint, {
+                method: 'POST',
+                signal: abort.signal,
+                headers: { 'Content-Type': 'application/json', 'X-Video-Token': token },
+                body: JSON.stringify({ kind: 'stats', id: identity, values }),
+              });
+            }
+          } catch {
+            /* Telemetry failure must not interrupt media. */
+          } finally {
+            measuring = false;
+          }
+        }, 3000);
+        clock.onmessage = () => {
+          const tickStarted = performance.now();
+          try {
+            if (current.connectionState === 'connected') {
+              // WebGL's default drawing buffer may be cleared after presentation.
+              // Redraw synchronously before copying, even when the game tab is visible.
+              const version = render();
+              if (typeof version === 'number' && version !== lastVersion) {
+                uniqueFrames++;
+                lastVersion = version;
+              }
+              context!.drawImage(canvas, 0, 0, output.width, output.height);
+              track.requestFrame();
+              presented();
+              ticks++;
+              renderTime += performance.now() - tickStarted;
+            }
+          } finally {
+            // One outstanding tick at most, even when encoding or the VM stalls.
+            clock?.postMessage(0);
+          }
+        };
+      }
+      if (peer && ['failed', 'closed'].includes(peer.connectionState)) reset();
+    } catch {
+      reset();
+    } finally {
+      if (!dead) timer = setTimeout(poll, 750);
+    }
+  }
+  void poll();
+  return () => {
+    dead = true;
+    clearTimeout(timer);
+    abort.abort();
+    reset();
+  };
+}
