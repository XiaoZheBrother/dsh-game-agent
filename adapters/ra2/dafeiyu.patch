+import { afterEach, expect, it, vi } from 'vitest';
+import { startCanvasBroadcast } from '../../src/platform/browser/canvasBroadcast';
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.useRealTimers();
+});
+
+it('bounds encoder size, uses a single worker and releases capture resources', async () => {
+  vi.useFakeTimers();
+  const drawImage = vi.fn();
+  const track = { stop: vi.fn(), requestFrame: vi.fn(), contentHint: '' };
+  const audioClone = { stop: vi.fn() };
+  const sourceTrack = { id: 'game-audio', clone: vi.fn(() => audioClone), stop: vi.fn() };
+  const tracks = [track];
+  const output = {
+    width: 0,
+    height: 0,
+    getContext: () => ({ drawImage }),
+    captureStream: vi.fn(() => ({
+      getVideoTracks: () => [track],
+      getTracks: () => tracks,
+      addTrack: (value: typeof track) => tracks.push(value),
+    })),
+  };
+  const document = { hidden: true, createElement: () => output };
+  const parameters = { encodings: [{}], degradationPreference: '' };
+  const sender = { getParameters: () => parameters, setParameters: vi.fn(async () => {}) };
+  class Peer {
+    connectionState = 'connected';
+    iceGatheringState = 'complete';
+    localDescription = { sdp: 'v=0' };
+    setRemoteDescription = vi.fn(async () => {});
+    setLocalDescription = vi.fn(async () => {});
+    createAnswer = vi.fn(async () => ({ sdp: 'v=0' }));
+    addTrack = () => sender;
+    close = vi.fn();
+  }
+  const workers: Clock[] = [];
+  class Clock {
+    onmessage: (() => void) | null = null;
+    postMessage = vi.fn();
+    terminate = vi.fn();
+    constructor() {
+      workers.push(this);
+    }
+  }
+  vi.stubGlobal('document', document);
+  vi.stubGlobal('RTCPeerConnection', Peer);
+  vi.stubGlobal('Worker', Clock);
+  vi.stubGlobal(
+    'fetch',
+    vi.fn(async () => ({ ok: true, json: async () => ({ token: 'test', signal: { id: 'one', offer: 'v=0' } }) })),
+  );
+  const render = vi.fn();
+  const stop = startCanvasBroadcast(
+    { width: 2048, height: 1536 } as HTMLCanvasElement,
+    render,
+    'http://127.0.0.1/test',
+    () => {},
+    () => ({ getAudioTracks: () => [sourceTrack] }) as unknown as MediaStream,
+  );
+  await vi.advanceTimersByTimeAsync(1);
+  expect([output.width, output.height]).toEqual([1280, 960]);
+  expect(parameters.encodings[0]).toMatchObject({ maxFramerate: 60, maxBitrate: 10_000_000 });
+  expect(workers).toHaveLength(1);
+  workers[0]!.onmessage!();
+  expect(render).toHaveBeenCalledTimes(1);
+  expect(track.requestFrame).toHaveBeenCalledTimes(1);
+  document.hidden = false;
+  workers[0]!.onmessage!();
+  expect(render).toHaveBeenCalledTimes(2);
+  expect(drawImage).toHaveBeenCalledTimes(2);
+  stop();
+  expect(audioClone.stop).toHaveBeenCalledTimes(1);
+  expect(sourceTrack.stop).not.toHaveBeenCalled();
+  expect(track.stop).toHaveBeenCalledTimes(1);
+  expect(workers[0]!.terminate).toHaveBeenCalledTimes(1);
+});
